{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:springBoot",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Group GitHub Actions updates to keep CI PR noise down",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    }
  ]
}